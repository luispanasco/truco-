// La web en Cloudflare Workers (ver INSTRUCTIVO-PUBLICAR.md): archivos estáticos y un Worker chico
// (worker/index.js) que solo corre cuando un pedido no es un archivo. Cloudflare compila con
// `pnpm --filter @truco/web build` (con las VITE_… como variables de build) y publica con
// `npx wrangler deploy` (main) o `npx wrangler preview` (las otras ramas).
{
  "name": "truco",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // El link de producción (main) y los de prueba de las otras ramas (develop → develop-truco…).
  // Van acá y no solo en el panel: cada deploy aplica lo que dice este archivo.
  "workers_dev": true,
  "preview_urls": true,
  // Lo pide `wrangler preview` (el comando de las ramas que no son main). Vacío: usa lo de arriba.
  "previews": {},
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    // La app es de una sola página: lo que no es un archivo (/ranking, /tienda…) va al index.html.
    // /privacidad sí es un archivo (privacidad.html) y se sirve tal cual. En las previews esto no
    // se respeta: lo resuelve worker/index.js.
    "not_found_handling": "single-page-application"
  }
}
